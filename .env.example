### Domain name for the app
DOMAIN=localhost

### Environment: development, test, production
ENVIRONMENT=development

### Project name and stack name
PROJECT_NAME=polibench
STACK_NAME=polibench

### Email adress used by traefik to obtain Let's Encrypt certificates
TRAEFIK_TLS_EMAIL=admin@polibench.com

### Docker package registry and images
DOCKER_IMAGE_BACKEND=polibench-backend
DOCKER_IMAGE_FRONTEND=polibench-frontend
DOCKER_PACKAGE_REPOSITORY=ghcr.io/baraff

### Backend variables
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:5173", "https://localhost", "https://localhost:5173", "http://0.0.0.0", "http://0.0.0.0:5173"]
SECRET_KEY=changeme-generate-a-random-key
FIRST_SUPERUSER=admin@polibench.com
FIRST_SUPERUSER_PASSWORD=admin

### SSO variables
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
### HOSTNAME used to build google redirect uri. Should point to backend
SSO_CALLBACK_HOSTNAME=http://localhost:8000
### Callback URL we redirect to after google login. Should point to frontend/sso-login-callback
SSO_LOGIN_CALLBACK_URL=http://localhost:5173/sso-login-callback

### Frontend variables
VITE_BACKEND_API_URL=http://localhost/api/v1/
VITE_PWD_SIGNUP_ENABLED=true
FRONTEND_URL=http://localhost:5173

### SMTP variables (uncomment and fill for email verification)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@polibench.com
# SMTP_TLS=true

### MongoDB variables
MONGO_HOST=localhost
MONGO_DB=polibench
MONGO_PORT=27017
MONGO_USER=mongodbadmin
MONGO_PASSWORD=wpnimdabdognom

### Mongo Express (web UI for MongoDB) — http://localhost/mongo-express
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
